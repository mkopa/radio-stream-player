{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login Schema",
  "description": "Schema for validating user login data",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "minLength": 5,
      "maxLength": 255
    },
    "password": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["email", "password"],
  "additionalProperties": false
}