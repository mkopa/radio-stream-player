              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/stations/{{station_id}}",
              "host": ["{{base_url}}"],
              "path": ["stations", "{{station_id}}"]
            },
            "description": "Get detailed information about a specific radio station. Requires JWT authentication."
          },
          "response": []
        },
        {
          "name": "Create Station",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Station created successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('stationId');",
                  "    pm.expect(jsonData).to.have.property('stationuuid');",
                  "    pm.expect(jsonData.message).to.include('created successfully');",
                  "    ",
                  "    // Save created station ID",
                  "    pm.collectionVariables.set('station_id', jsonData.stationId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate UUIDs for the new station",
                  "const { v4: uuidv4 } = require('uuid');",
                  "pm.collectionVariables.set('new_changeuuid', uuidv4());",
                  "pm.collectionVariables.set('new_stationuuid', uuidv4());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changeuuid\": \"{{$guid}}\",\n  \"stationuuid\": \"{{$guid}}\",\n  \"name\": \"Test Radio Station\",\n  \"url\": \"http://stream.example.com/radio\",\n  \"homepage\": \"http://example.com\",\n  \"country\": \"United States\",\n  \"countrycode\": \"US\",\n  \"state\": \"California\",\n  \"language\": \"English\",\n  \"tags\": \"rock,alternative,indie\",\n  \"codec\": \"MP3\",\n  \"bitrate\": 128,\n  \"votes\": 0,\n  \"lastcheckok\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/stations",
              "host": ["{{base_url}}"],
              "path": ["stations"]
            },
            "description": "Create a new radio station. Requires JWT authentication."
          },
          "response": []
        },
        {
          "name": "Update Station",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Station updated successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('updated successfully');",
                  "    pm.expect(jsonData).to.have.property('stationId');",
                  "});"
