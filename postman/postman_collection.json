                  "",
                  "pm.test('Station deleted successfully', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('deleted successfully');",
                  "    pm.expect(jsonData).to.have.property('stationId');",
                  "});"
