                {
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of results"
                }
              ]
            },
            "description": "Search stations using fulltext search on name, tags, country, and state. Requires JWT authentication."
          },
          "response": []
        },
        {
          "name": "Get Station by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has station object', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('station');",
                  "    pm.expect(jsonData.station).to.be.an('object');",
                  "    pm.expect(jsonData.station).to.have.property('id');",
                  "    pm.expect(jsonData.station).to.have.property('name');",
                  "    pm.expect(jsonData.station).to.have.property('url');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
